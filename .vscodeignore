# src/ is kept so the bundled sourcemap resolves, but nothing test- or
# build-related belongs in a shipped extension.
**/*.test.ts
src/testing/**
# The Claude Code plugin is installed from the git repo via /plugin, never
# from the .vsix — shipping a copy here would just go stale.
plugins/**
.claude-plugin/**
docs/**
# Icons are fetched from jsDelivr at runtime, never read from disk.
assets/**
scripts/**
tsconfig.json
tsup.config.ts
# Local agent config and CI, not part of the extension.
.claude/**
.github/**
.gitignore
# Publishing credentials live here. vsce refuses to package a .vsix containing
# one at all, so this is what makes `publish:ovsx` work from a shell that reads
# an .env rather than exporting the token by hand.
.env
.env.*
node_modules/**
scratchpad/**
*.vsix
